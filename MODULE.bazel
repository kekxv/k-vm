module(
    name = "k_vm",
    version = "0.1.0",
)

bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.0.0")

macos_dependencies = use_repo_rule("//build:macos_deps.bzl", "macos_dependencies")
macos_dependencies(name = "macos_openssl", formula = "openssl@3", library = "libcrypto.dylib")
macos_dependencies(name = "macos_sdl", formula = "sdl12-compat", library = "libSDL.dylib")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")
# Opt in via --extra_toolchains in .bazelrc; native builds keep their system compiler.
